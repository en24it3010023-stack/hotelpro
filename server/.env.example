# Server Configuration
PORT=5001
NODE_ENV=development

# Database Configuration (Leave empty to use automatic embedded MongoMemoryServer for instant local run)
MONGODB_URI=

# JWT Authentication
JWT_SECRET=hotelpro_jwt_secret_dev_key_production_ready_secure_hash_2026
JWT_EXPIRES_IN=7d

# Frontend Client URL for CORS
CLIENT_URL=http://localhost:5173

# Payment Gateway Configuration
# Mode options: 'demo' (mock payments for quick testing), 'razorpay', 'stripe'
PAYMENT_MODE=demo
RAZORPAY_KEY_ID=rzp_test_sampleKeyId
RAZORPAY_KEY_SECRET=sampleRazorpaySecretKey
STRIPE_SECRET_KEY=sk_test_sampleStripeSecretKey

# Nodemailer / Email Configuration (Falls back to console logger if credentials are blank)
EMAIL_HOST=smtp.ethereal.email
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=HotelPro Luxury Stays <reservations@hotelpro.com>
